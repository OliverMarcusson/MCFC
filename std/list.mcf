// Helpers for arrays. Each is generic, so `T` can be any element type that
// supports the operators the helper uses: `+` for `sum`, `<` and `>` for
// `min` and `max`. That means `int` and `float`.

// Sum of all elements. An empty array gives 0.
public <T> T sum(List<T> xs) {
    var total = xs[0];
    for (int i = 1; i < xs.size(); i++) {
        total = total + xs[i];
    }
    return total;
}

// Smallest element. An empty array gives 0.
public <T> T min(List<T> xs) {
    var best = xs[0];
    for (var x : xs) {
        if (x < best) {
            best = x;
        }
    }
    return best;
}

// Largest element. An empty array gives 0.
public <T> T max(List<T> xs) {
    var best = xs[0];
    for (var x : xs) {
        if (x > best) {
            best = x;
        }
    }
    return best;
}

// `sortBy` and `top` order any list by a parallel list of int keys, where
// `keys[i]` belongs to `items[i]`, such as player names and their scores.
// ponytail: insertion sort, O(n²) commands; fine for player-sized lists.

// `items` ordered by `keys`, smallest first. Equal keys keep their order.
public <T> List<T> sortBy(List<T> items, List<Integer> keys) {
    List<Integer> order = List.of();
    for (int i = 0; i < items.size(); i++) {
        var j = order.size();
        while (j > 0 && keys[order[j - 1]] > keys[i]) {
            j = j - 1;
        }
        order.add(j, i);
    }
    return pick(items, order);
}

// The `n` items with the largest keys, largest first. Equal keys keep their order.
public <T> List<T> top(List<T> items, List<Integer> keys, int n) {
    List<Integer> order = List.of();
    for (int i = 0; i < items.size(); i++) {
        var j = order.size();
        while (j > 0 && keys[order[j - 1]] < keys[i]) {
            j = j - 1;
        }
        if (j < n) {
            order.add(j, i);
            if (order.size() > n) {
                order.removeLast();
            }
        }
    }
    return pick(items, order);
}

<T> List<T> pick(List<T> items, List<Integer> indexes) {
    List<T> out = List.of();
    for (var i : indexes) {
        out.add(items[i]);
    }
    return out;
}
