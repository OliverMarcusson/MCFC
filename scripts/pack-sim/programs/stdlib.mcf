// std.math generics, String.join, std.list sortBy/top, std.time, std.random.
import std.math;
import std.list;
import std.time;
import std.random;

void main() {
    mcf("say math $(math.min(1.5, 2)) $(math.max(3, 9)) $(math.abs(-2.5)) $(math.clamp(15, 0, 10)) $(math.sign(-4)) $(math.isqrt(50))");
    List<String> names = List.of("ann", "bob", "cy", "dee", "eve");
    List<Integer> scores = List.of(30, 10, 50, 10, 40);
    var joined = String.join(", ", list.sortBy(names, scores));
    var best = String.join(",", list.top(names, scores, 3));
    mcf("say sort $(joined) top $(best)");
    mcf("say time $(time.formatTicks(1300)) $(time.formatTicks(-5)) $(time.formatTicks(80000)) $(time.padLeft(7, 3))");
    List<Integer> xs = List.of(1, 2, 3, 4, 5);
    var shuffled = random.shuffle(xs);
    var total = 0;
    for (var x : shuffled) {
        total += x;
    }
    var f = random.nextFloat();
    var inRange = f >= 0.0 && f < 1.0;
    mcf("say random $(shuffled.size()) $(total) $(random.chance(1.0)) $(random.chance(0.0)) $(inRange) $(xs.contains(random.pick(xs)))");
}
