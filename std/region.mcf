// Box-shaped areas, such as an arena, given by two opposite corner blocks.
// Both corners are inside the region.

import std.math.Math;

public record Region(int minX, int minY, int minZ, int maxX, int maxY, int maxZ) {
    // The region between two corners, in any order.
    public static Region of(Block a, Block b) {
        var ax = a.getX();
        var ay = a.getY();
        var az = a.getZ();
        var bx = b.getX();
        var by = b.getY();
        var bz = b.getZ();
        return new Region(Math.min(ax, bx), Math.min(ay, by), Math.min(az, bz), Math.max(ax, bx), Math.max(ay, by), Math.max(az, bz));
    }

    // `true` when the entity's feet are in one of the region's blocks.
    public boolean contains(Entity entity) {
        var x = entity.getX();
        var y = entity.getY();
        var z = entity.getZ();
        return x >= minX && x < maxX + 1 && y >= minY && y < maxY + 1 && z >= minZ && z < maxZ + 1;
    }

    // How many players are inside.
    public int countPlayers() {
        var n = 0;
        for (var player : Selector.of("@a")) {
            if (contains(player)) {
                n += 1;
            }
        }
        return n;
    }

    // Gives `tag` to the players inside and takes it from everyone else, so
    // `Selector.allPlayers().tag(tag)` selects them.
    public void tagPlayers(String tag) {
        for (var player : Selector.of("@a")) {
            if (contains(player)) {
                player.addTag(tag);
            } else {
                player.removeTag(tag);
            }
        }
    }

    // A random block inside, for spawn points and drops.
    public Block randomBlock() {
        return Block.of(random(minX, maxX), random(minY, maxY), random(minZ, maxZ));
    }

    // The middle block, rounded down.
    public Block center() {
        return Block.of((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2);
    }

    // Fills the whole region; large regions need `fill`'s 32768-block limit in mind.
    public void fill(String block) {
        Block.of(minX, minY, minZ).fill(Block.of(maxX, maxY, maxZ), block);
    }
}
