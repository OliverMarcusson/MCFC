{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MCFC",
  "scopeName": "source.mcfc",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mcfc",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mcfc",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.mcfc",
          "match": "\\\\(?:[\"\\\\nt]|.)"
        }
      ]
    },
    "macro-placeholders": {
      "patterns": [
        {
          "name": "constant.other.placeholder.macro.mcfc",
          "match": "\\$\\([A-Za-z_][A-Za-z0-9_]*(?:[^()]|\\([^()]*\\))*\\)"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mcfc",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.mcfc"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.mcfc"
            }
          },
          "patterns": [
            {
              "include": "#macro-placeholders"
            },
            {
              "include": "#escapes"
            }
          ]
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.mcfc",
          "match": "(@)(EventHandler|Command|Every|After|PlayerState|EntityState|Book|[A-Za-z_][A-Za-z0-9_]*)\\b(?:\\s*\\(\\s*([A-Z][A-Z0-9_]*)\\s*\\))?",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.mcfc" },
            "2": { "name": "storage.type.annotation.mcfc" },
            "3": { "name": "variable.other.enummember.mcfc" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.record.definition.mcfc",
          "match": "\\b(record)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.record.mcfc" }, "2": { "name": "entity.name.type.record.mcfc" } }
        },
        {
          "name": "meta.enum.definition.mcfc",
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.enum.mcfc" }, "2": { "name": "entity.name.type.enum.mcfc" } }
        },
        {
          "name": "meta.import.mcfc",
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": { "1": { "name": "keyword.other.import.mcfc" }, "2": { "name": "entity.name.namespace.mcfc" } }
        },
        {
          "name": "meta.function.definition.mcfc",
          "match": "^\\s*(?:(public)\\s+)?(?:<[^>]*>\\s*)?([A-Za-z_][A-Za-z0-9_]*(?:<[^()]*>)?)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "storage.modifier.mcfc" },
            "2": { "name": "storage.type.mcfc" },
            "3": { "name": "entity.name.function.mcfc" }
          }
        },
        {
          "name": "meta.new.mcfc",
          "match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.operator.new.mcfc" }, "2": { "name": "entity.name.type.mcfc" } }
        },
        {
          "name": "meta.cast.mcfc",
          "match": "\\((int|float|boolean|String|Player)\\)",
          "captures": { "1": { "name": "storage.type.mcfc" } }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.switch.case.mcfc",
          "match": "\\b(case)\\s+([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.control.mcfc" }, "2": { "name": "entity.name.type.enum.mcfc" }, "3": { "name": "variable.other.enummember.mcfc" } }
        },
        {
          "name": "entity.name.function.call.mcfc",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mcfc",
          "match": "\\b(?:if|else|switch|case|default|yield|while|do|for|break|continue|return|async)\\b"
        },
        {
          "name": "keyword.other.module.mcfc",
          "match": "\\b(?:import|public|final|static)\\b"
        },
        {
          "name": "storage.modifier.declaration.mcfc",
          "match": "\\b(?:var|record|enum)\\b"
        },
        {
          "name": "keyword.operator.new.mcfc",
          "match": "\\bnew\\b"
        },
        {
          "name": "keyword.other.command.mcfc",
          "match": "\\b(?:mc|mcf)\\b(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.mcfc",
          "match": "\\b(?:int|float|boolean|Integer|Float|Boolean|String|Math|void|List|Map|Optional|Selector|Entity|Player|Block|EntityData|BlockData|ItemStack|Component|ItemSlot|BossBar|Nbt|CommandSender|[A-Z][A-Za-z0-9]*Event)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.mcfc",
          "match": "\\b(?:hasData|sleep|sleepTicks|random|randomWeighted|randomBinomial|gamerule|at|as|summon|debug|http|file|kv|db|time|rand)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.builtin.mcfc",
          "match": "\\b(?:List|Map)\\.(of)\\b(?=\\s*\\()",
          "captures": { "1": { "name": "support.function.builtin.mcfc" } }
        },
        {
          "name": "support.function.method.mcfc",
          "match": "(?<=\\.)\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
        },
        {
          "name": "support.variable.member.mcfc",
          "match": "(?<=\\.)\\b(?:position|team|nbt|state|tags|inventory|hotbar|mainhand|offhand|head|chest|legs|feet|item|count|name|value|max|visible|players|states|exists|id|nameVisible|noAi|silent|glowing|lock|lootTable|lootSeed)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.mcfc",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.mcfc",
          "match": "\\b(?:[0-9][0-9_]*\\.[0-9][0-9_]*[fF]?|[0-9][0-9_]*[fF])\\b"
        },
        {
          "name": "constant.numeric.integer.hex.mcfc",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.integer.mcfc",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.mcfc",
          "match": "->|\\?|:"
        },
        {
          "name": "keyword.operator.logical.mcfc",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.increment.mcfc",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.comparison.mcfc",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.compound.mcfc",
          "match": "[+\\-*/%]="
        },
        {
          "name": "keyword.operator.assignment.mcfc",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.mcfc",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.mcfc",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.mcfc",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.mcfc",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.mcfc",
          "match": "\\."
        },
        {
          "name": "punctuation.bracket.mcfc",
          "match": "[()\\[\\]{}<>]"
        }
      ]
    }
  }
}
