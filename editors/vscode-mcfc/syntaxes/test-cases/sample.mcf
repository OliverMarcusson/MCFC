// MCFC syntax highlighting fixture
/* block comment */
import util.math.clamp;

@PlayerState("Coins")
int coins;

@EntityState
String title;

enum Mode { IDLE, RUNNING }

record Reward(String item, int count) {}

@Event(PLAYER_JOIN)
void onPlayerJoin(Player player) {
    player.tellraw("Welcome to MCFC");
}

@Event(CHAT)
void onChat(ChatEvent event) {
    event.player.actionbar("chat: $(event.message)");
}

@Command("status")
void status(Player player) {
    player.tellraw("coins=$(player.state.coins)");
}

@Every(ticks = 20)
void heartbeat() {
    mc("say heartbeat");
}

public <T> T first(List<T> values) {
    return values.getFirst();
}

int score(Mode mode, float speed) {
    var reward = new Reward("minecraft:apple", 2);
    List<int> values = List.of(1, 2, 3);
    Map<String, int> totals = Map.of("a", 1);
    boolean ready = !false && (values.size() > 0 || totals.containsKey("a"));
    for (int i = 0; i < 3; i++) {
        if (i == 1) {
            continue;
        }
    }
    for (Player p : selector("@a")) {
        p.addTag("seen");
    }
    switch (mode) {
        case Mode.IDLE -> mcf("say $(reward.item)");
        default -> {
            sleepTicks(20);
        }
    }
    async {
        sleep(1);
    }
    as (single(selector("@p"))) {
        mc("say hi");
    }
    var stack = new ItemStack("minecraft:stick");
    var who = (Player) single(selector("@p"));
    who.state.coins += 1;
    return (int) speed;
}
