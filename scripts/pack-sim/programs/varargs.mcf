// Varargs parameters and String.format.
class Main {
    static int sum(int... values) {
        int total = 0;
        for (int value : values) {
            total += value;
        }

        return total;
    }

    static String join(String separator, String... parts) {
        String out = "";
        for (int index = 0; index < parts.size(); index++) {
            if (index > 0) {
                out = out + separator;
            }
            out = out + parts[index];
        }

        return out;
    }

    static <T> int count(T... items) {
        return items.size();
    }

    public static void main() {
        List<Integer> numbers = List.of(4, 5);
        String sums = "sums " + sum() + " " + sum(1) + " " + sum(1, 2, 3) + " " + sum(numbers);
        Commands.run("say $(sums)");
        String joined = "joined " + join("-", "a", "b", "c") + " [" + join("-") + "] " + count("x", "y") + " " + count(1, 2, 3);
        Commands.run("say $(joined)");
        Logger logger = new Logger();
        String logged = logger.line("hello", "world");
        Commands.run("say $(logged)");
        String line = String.format("%s has %d kills (100%%)", "alex", 7);
        Commands.run("say $(line)");
    }
}

class Logger {
    String prefix = "log";

    String line(String... words) {
        return prefix + ": " + Main.join(" ", words);
    }
}
