// Entity and player actions: `player.setGameMode(...)` and friends. An
// `Entity` method also runs on a `Player`, and on a `Selector`, where it
// applies to every match.

import std.gamemode.GameMode;
import std.vec.Vec3;

public final class Entity {
    public void setGameMode(GameMode mode) {
        String name = switch (mode) {
            case SURVIVAL -> "survival";
            case CREATIVE -> "creative";
            case ADVENTURE -> "adventure";
            case SPECTATOR -> "spectator";
        };
        as (this) {
            mcf("gamemode $(name) @s");
        }
    }

    public void setLevel(int levels) {
        as (this) {
            mcf("xp set @s $(levels) levels");
        }
    }

    // Adds (or with a negative number, removes) whole levels.
    public void giveExpLevels(int levels) {
        as (this) {
            mcf("xp add @s $(levels) levels");
        }
    }

    // Adds experience points, which fill the bar and roll over into levels.
    public void giveExp(int points) {
        as (this) {
            mcf("xp add @s $(points) points");
        }
    }

    // The subtitle is set first, since the title shows both.
    public void sendTitle(String title, String subtitle) {
        as (this) {
            mcf("title @s subtitle \"$(subtitle)\"");
        }
        this.sendTitle(title);
    }

    // Times in ticks.
    public void sendTitle(String title, String subtitle, int fadeIn, int stay, int fadeOut) {
        as (this) {
            mcf("title @s times $(fadeIn) $(stay) $(fadeOut)");
        }
        this.sendTitle(title, subtitle);
    }

    // Removes the entity from the world. Players die instead.
    public void remove() {
        as (this) {
            mc("kill @s");
        }
    }

    // Views the world from `camera`, as a spectator does. Players only, in spectator mode.
    public void spectate(Entity camera) {
        as (camera) {
            mc("tag @s add mcfc_spectate");
        }
        as (this) {
            mc("spectate @e[tag=mcfc_spectate,limit=1] @s");
        }
        as (camera) {
            mc("tag @s remove mcfc_spectate");
        }
    }

    public void stopSpectating() {
        as (this) {
            mc("spectate");
        }
    }

    // Moves to an exact position, facing yaw and pitch in degrees. Teleporting
    // to a `Block` centres on it instead.
    public void teleport(Vec3 pos, float yaw, float pitch) {
        float x = pos.x();
        float y = pos.y();
        float z = pos.z();
        as (this) {
            mcf("teleport @s $(x) $(y) $(z) $(yaw) $(pitch)");
        }
    }
}

public final class Player {
    public GameMode getGameMode() {
        int id = (int) this.nbt.playerGameType;
        if (id == 1) {
            return GameMode.CREATIVE;
        }
        if (id == 2) {
            return GameMode.ADVENTURE;
        }
        if (id == 3) {
            return GameMode.SPECTATOR;
        }

        return GameMode.SURVIVAL;
    }
}
