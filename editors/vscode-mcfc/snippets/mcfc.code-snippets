{
  "Function": { "prefix": "fn", "body": ["fn ${1:name}(${2}) -> ${3:void}:", "    ${0}"], "description": "MCFC function" },
  "Enum": { "prefix": "enum", "body": ["enum ${1:Mode}:", "    ${2:IDLE}", "    ${3:RUNNING}"], "description": "Named enum constants" },
  "Switch": { "prefix": "switch", "body": ["switch ${1:mode}:", "    case ${2:Mode.IDLE}:", "        ${0}", "    default:", "        "], "description": "Switch over an enum or integer" },
  "Switch case": { "prefix": "case", "body": ["case ${1:Mode.IDLE}:", "    ${0}"], "description": "Switch case arm" },
  "Player data": { "prefix": "data-player", "body": "data player.${1:name}: ${2:int} = ${3:0}", "description": "Scoreboard-backed player data" },
  "Player state": { "prefix": "player-state", "body": "player_state ${1:title}: ${2:string} = \"${3:Title}\"", "description": "Declare typed persistent player state" },
  "Entity state": { "prefix": "entity-state", "body": "entity_state ${1:title}: ${2:string}", "description": "Declare typed persistent entity state" },
  "Safe array lookup": { "prefix": "array-get", "body": "${1:items}.get(${2:index}).orElse(${3:fallback})", "description": "Look up an array value with a fallback" },
  "Safe entity lookup": { "prefix": "find-first", "body": "find_first(selector(${1:\"@p\"}))", "description": "Find the first entity as an Optional" },
  "Vanilla event": { "prefix": "event", "body": ["event ${1:player_join}:", "    ${0}"], "description": "Vanilla lifecycle event" },
  "Agent event": { "prefix": "agent-event", "body": ["event ${1:chat}(event: ${2:chat_event}):", "    ${0}"], "description": "Typed JVM-agent event" },
  "Command": { "prefix": "command", "body": ["command ${1:status}:", "    ${0}"], "description": "MCFC command" },
  "Repeating task": { "prefix": "task", "body": ["task ${1:name} every_ticks(${2:20}):", "    ${0}"], "description": "Repeating task" },
  "Async": { "prefix": "async", "body": ["async:", "    ${0}"], "description": "Async block" },
  "Host call": { "prefix": "host", "body": "${1:http}.${2:get}(${0})", "description": "Capability-gated host call" }
}
