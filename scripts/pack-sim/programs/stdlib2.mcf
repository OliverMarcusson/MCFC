// std.str formatting, @WorldState and std.timer; the world is empty, so no players.
import std.str;
import std.timer;

@WorldState
int round;

@WorldState
List<String> log;

void main() {
    mcf("say f $(str.formatFloat(3.14159, 2)) $(str.formatFloat(-1.26, 1)) $(str.formatFloat(2.0, 1)) $(str.formatFloat(7.6, 0))");
    mcf("say c $(str.withCommas(1234567)) $(str.withCommas(-1000)) $(str.withCommas(999)) $(str.withCommas(0))");
    round += 1;
    log.add("r" + round);
    mcf("say world $(round) $(log.size())");
    timer.start("round", 20);
    mcf("say timer $(timer.running(\"round\")) $(timer.remaining(\"round\")) $(timer.running(\"other\"))");
}

@Every(ticks = 30)
void later() {
    mcf("say later $(timer.running(\"round\")) $(timer.remaining(\"round\")) $(round)");
    timer.stop("round");
}
