import std.math.clamp;
import std.math.gcd;
import std.math.pow;
import std.list.sum;
import std.list.max;
import std.str.contains;
import std.str.find;

record Quest(String name, int reward) {}

Quest bump(Quest q, int by) {
    return new Quest(q.name(), q.reward() + by);
}

<T> T largest(List<T> xs) {
    return max(xs);
}

void main() {
    var q = new Quest("Mine", 5);
    q = bump(q, 3);
    mcf("say quest $(q.name()) $(q.reward())");
    var xs = List.of(4, 9, 2, 7);
    xs.add(11);
    var popped = xs.removeLast();
    var total_xs = sum(xs);
    var big = largest(xs);
    mcf("say arr $(total_xs) $(big) $(popped) $(xs.size())");
    var first = xs.get(10).orElse(-1);
    var second = xs.get(1).orElse(-1);
    mcf("say opt $(first) $(second)");
    var d = Map.of("red", 1);
    d["blue"] = 4;
    var missing = d.get("green").orElse(0);
    var red = d["red"];
    var blue = d["blue"];
    mcf("say dict $(red) $(blue) $(missing) $(d.size())");
    var c = clamp(50, 0, 20);
    var g = gcd(12, -18);
    var p = pow(3, 4);
    mcf("say math $(c) $(g) $(p)");
    var s = "hello world";
    var has = contains(s, "wor");
    var at = find(s, "o");
    if (has) {
        mcf("say str $(at) $(s.length())");
    }
    switch ("jump") {
        case "jump" -> mc("say leap");
        case "run" -> mc("say go");
        default -> mc("say idle");
    }
    var total = 0;
    for (int i = 0; i <= 5; i++) {
        total = total + i;
    }
    mcf("say incl $(total)");
}
