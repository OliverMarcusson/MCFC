# Helpers for arrays. Each is generic, so `T` can be any element type that
# supports the operators the helper uses: `+` for `sum`, `<` and `>` for
# `min` and `max`. That means `int` and `float`.

# Sum of all elements. An empty array gives 0.
pub fn sum<T>(xs: array<T>) -> T:
    let total = xs[0]
    for i in 1..xs.len():
        total = total + xs[i]
    return total

# Smallest element. An empty array gives 0.
pub fn min<T>(xs: array<T>) -> T:
    let best = xs[0]
    for x in xs:
        if x < best:
            best = x
    return best

# Largest element. An empty array gives 0.
pub fn max<T>(xs: array<T>) -> T:
    let best = xs[0]
    for x in xs:
        if x > best:
            best = x
    return best
