// MCFC syntax highlighting fixture
/* block comment */
import util.math.clamp;

class Main implements Listener {
    @PlayerState("Coins")
    static int coins;

    @EntityState
    static String title;

    @EventHandler
    void onPlayerJoin(PlayerJoinEvent event) {
        Player player = event.player();
        player.sendMessage("Welcome to MCFC");
    }

    @EventHandler
    void onChat(ChatEvent event) {
        event.player().sendActionBar("chat: $(event.message())");
    }

    @Command("status")
    static void status(Player player) {
        player.sendMessage("coins=$(player.state.coins)");
    }

    @Every(ticks = 20)
    static void heartbeat() {
        Commands.run("say heartbeat");
    }

    public static <T> T first(List<T> values) {
        return values.getFirst();
    }

    static int score(Mode mode, float speed) {
        var reward = new Reward("minecraft:apple", 2);
        List<Integer> values = List.of(1, 2, 3);
        Map<String, Integer> totals = Map.of("a", 1);
        boolean ready = !false && (values.size() > 0 || totals.containsKey("a"));
        for (int i = 0; i < 3; i++) {
            if (i == 1) {
                continue;
            }
        }
        for (Player p : Selector.of("@a")) {
            p.addTag("seen");
        }
        switch (mode) {
            case Mode.IDLE -> Commands.run("say $(reward.item())");
            default -> {
                Thread.sleepTicks(20);
            }
        }
        Thread.start(() -> {
            Thread.sleep(1);
        });
        Execute.as(Selector.of("@p").getFirst(), () -> {
            Commands.run("say hi");
        });
        var stack = new ItemStack("minecraft:stick");
        var who = (Player) Selector.of("@p").getFirst();
        who.state.coins += 1;
        final int flags = 0xFF;
        var scaled = 1_000 + flags;
        var fraction = 1.5f;
        var chosen = ready ? scaled : 2;
        do { chosen--; } while (chosen > 0);
        return (int) speed;
    }
}

enum Mode { IDLE, RUNNING }

record Reward(String item, int count) {}
