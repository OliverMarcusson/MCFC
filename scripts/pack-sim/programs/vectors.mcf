// std.vec methods.
import std.vec.Vec3;

class Main {
    public static void main() {
        Vec3 look = new Vec3(3.0, 0.0, 4.0);
        Vec3 up = new Vec3(0.0, 1.0, 0.0);
        Vec3 push = look.normalize().add(up).scale(2.0);
        float size = look.length();
        float dot = look.dot(up);
        Vec3 side = look.cross(up);
        Vec3 zero = new Vec3(0.0, 0.0, 0.0).normalize();
        String line = "$(push) $(size) $(dot) $(side) $(zero)";
        mcf("say $(line)");
    }
}
