class Main {
    static String greet(String name, int times) {
        var out = "";
        for (int i = 0; i < times; i++) {
            out = "$(out)$(name)";
        }
        return out;
    }

    static String pick(boolean flag) {
        if (flag) {
            return "yes";
        }
        return "no";
    }

    public static void main() {
        var g = greet("ab", 3);
        Commands.run("say $(g)");
        var p = pick(true);
        var q = pick(false);
        Commands.run("say $(p) $(q)");
        var words = List.of("x", "yy", "zzz");
        var total = 0;
        for (var w : words) {
            total = total + w.size();
            if (w == "yy") {
                Commands.run("say found yy");
            }
        }
        Commands.run("say total $(total)");
    }
}
