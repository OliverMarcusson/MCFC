# Integer helpers. Scoreboard math is 32-bit and `/` rounds toward negative infinity.

pub fn min(a: int, b: int) -> int:
    if a < b:
        return a
    return b

pub fn max(a: int, b: int) -> int:
    if a > b:
        return a
    return b

pub fn abs(x: int) -> int:
    if x < 0:
        return -x
    return x

pub fn sign(x: int) -> int:
    if x > 0:
        return 1
    if x < 0:
        return -1
    return 0

pub fn clamp(x: int, low: int, high: int) -> int:
    if x < low:
        return low
    if x > high:
        return high
    return x

# Remainder with the sign of `b`, matching Minecraft's `%=` operation.
pub fn rem(a: int, b: int) -> int:
    return a % b

# `base` raised to `exponent`; exponents below zero return 0.
pub fn pow(base: int, exponent: int) -> int:
    if exponent < 0:
        return 0
    let result = 1
    let i = 0
    while i < exponent:
        result = result * base
        i = i + 1
    return result
