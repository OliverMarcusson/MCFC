// Vanilla Bukkit-style API conformance pack.
// Run `/function bukkit_api_conformance:run_all`, then use
// `/trigger status` as a player to exercise the command bridge.

@PlayerState("coins") int coins;
@PlayerState("completed") boolean completed;
@PlayerState("tests_passed") int tests_passed;
@PlayerState("arcade_score") int arcade_score;
@PlayerState("arcade_blocks") int arcade_blocks;
@PlayerState("arcade_hits") int arcade_hits;
@PlayerState("arcade_events") int arcade_events;
@PlayerState("arcade_slot") int arcade_slot;

@EventHandler
void onPlayerConnect(PlayerConnectEvent event) {
    var player = event.player;
    player.tellraw("Hello");
    player.state.coins = player.state.coins + 1;
    player.actionbar("MCFC Event Arcade ready — use /arcade");
}

@EventHandler
void onBlockBreak(BlockBreakEvent event) {
    event.cancel();
}

@EventHandler
void onPlayerDeath(PlayerDeathEvent event) {
    Player player = event.player;
    player.tellraw("you dead.");
    player.state.arcade_hits = 0;
}

// Event Arcade: packet callbacks are quiet by default and instead change the
// player's score, combo, hotbar state, or action bar.
@EventHandler
void onChat(ChatEvent event) {
    var player = single(Selector.of("@s"));
    if (event.message == "spark") {
        player.state.arcade_score = player.state.arcade_score + 3;
        player.actionbar("Spark! +3 arcade score");
        player.playsound("minecraft:entity.experience_orb.pickup", "master");
    }
}

@EventHandler
void onInventoryClick(InventoryClickEvent event) {
    var player = single(Selector.of("@s"));
    player.state.arcade_slot = event.slot;
    player.state.arcade_events = player.state.arcade_events + 1;
}

@EventHandler
void onPlayerAction(PlayerActionEvent event) {
    var player = single(Selector.of("@s"));
    player.state.arcade_events = player.state.arcade_events + 1;
}

@EventHandler
void onPlayerInteractBlock(PlayerInteractBlockEvent event) {
    var player = single(Selector.of("@s"));
    if (event.hand == "MAIN_HAND") {
        player.state.arcade_events = player.state.arcade_events + 1;
        player.actionbar("Touched $(event.face): $(event.x), $(event.y), $(event.z)");
    }
}

@EventHandler
void onEntityInteract(EntityInteractEvent event) {
    var player = single(Selector.of("@s"));
    if (event.secondary) {
        player.state.arcade_score = player.state.arcade_score + 1;
        player.actionbar("Sneak-interact bonus +1");
    }
}

@EventHandler
void onEntityAttack(EntityAttackEvent event) {
    var player = single(Selector.of("@s"));
    player.state.arcade_hits = player.state.arcade_hits + 1;
    player.state.arcade_score = player.state.arcade_score + 2;
    if (player.state.arcade_hits >= 3) {
        player.state.arcade_hits = 0;
        player.give("minecraft:cookie", 1);
        player.actionbar("3-hit combo! Cookie reward");
        player.playsound("minecraft:entity.arrow.hit_player", "master");
    }
}

@EventHandler
void onItemHeldChange(ItemHeldChangeEvent event) {
    var player = single(Selector.of("@s"));
    player.state.arcade_slot = event.slot;
}

@EventHandler
void onInventoryClose(InventoryCloseEvent event) {
    var player = single(Selector.of("@s"));
    player.state.arcade_events = player.state.arcade_events + 1;
}

@Command("status")
void status() {
    var player = single(Selector.of("@s"));
    player.tellraw("Arcade score=$(player.state.arcade_score), blocks=$(player.state.arcade_blocks), hits=$(player.state.arcade_hits), slot=$(player.state.arcade_slot), events=$(player.state.arcade_events)");
}

@Command("arcade")
void arcade() {
    var player = single(Selector.of("@s"));
    player.state.arcade_score = 0;
    player.state.arcade_blocks = 0;
    player.state.arcade_hits = 0;
    player.state.arcade_events = 0;
    player.actionbar("Event Arcade started: break blocks, attack, sneak-interact, or say spark");
    player.playsound("minecraft:block.note_block.pling", "master");
}

@After(ticks = 40)
void delayedNotice() {
    debug("bukkit_api_conformance delayed task fired");
}

void runAll() {
    var player = single(Selector.of("@p"));
    if (exists(player)) {
        player.state.tests_passed = 0;
        player.state.coins = 7;
        player.state.completed = true;
        player.state.tests_passed = player.state.tests_passed + 1;
        player.tellraw("data API: coins=7, completed=true");
        player.actionbar("MCFC Bukkit-style API conformance running");
        player.playsound("minecraft:entity.experience_orb.pickup", "master");

        var bar = new BossBar("bukkit_api_conformance:status", "MCFC API conformance");
        bar.max = 4;
        bar.value = 4;
        bar.players = player;
        bar.visible = true;
        player.state.tests_passed = player.state.tests_passed + 1;

        at (player) {
            Block.of("~ ~-1 ~").particle("minecraft:happy_villager", 8, player);
        }
        player.state.tests_passed = player.state.tests_passed + 1;

        var now = time.now();
        var roll = rand.int(1, 6);
        if (now.ok && roll.ok) {
            player.tellraw("mcfd services: unix=$(now.unix), roll=$(roll.value)");
            player.state.tests_passed = player.state.tests_passed + 1;
        }

        var saved = kv.set("conformance", "pass");
        var stored = kv.get("conformance");
        if (saved.ok && stored.ok) {
            player.tellraw("mcfd KV: $(stored.value)");
            player.state.tests_passed = player.state.tests_passed + 1;
        }

        player.tellraw("Use /trigger status for the command test, then chat, click an inventory slot, and break a block for agent callbacks.");
    }
}

void report() {
    var player = single(Selector.of("@p"));
    if (exists(player)) {
        player.tellraw("Conformance pass count=$(player.state.tests_passed); mcfd checks add two when available.");
    }
}

void cleanup() {
    var player = single(Selector.of("@p"));
    if (exists(player)) {
        player.stopsound("master", "minecraft:entity.experience_orb.pickup");
        player.tellraw("Conformance cleanup complete");
    }
}
