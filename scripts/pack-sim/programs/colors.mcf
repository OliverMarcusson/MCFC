// Also guards an optimizer bug: early returns in a function with several callers.
import std.color.Color;

class Main {
    public static void main() {
        var c = Color.rgb(255, 128, 300);
        var hex = Color.toHex(c);
        var r = Color.red(c);
        var g = Color.green(c);
        var b = Color.blue(c);
        mcf("say c $(c) hex $(hex) r $(r) g $(g) b $(b)");
        var back = Color.fromHex("#FF80fF");
        var bad = Color.fromHex("#12345g");
        var small = Color.toHex(Color.rgb(1, 2, 3));
        mcf("say back $(back) bad $(bad) small $(small)");
    }
}
