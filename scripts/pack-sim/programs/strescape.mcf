import std.str.Strings;

class Main {
    public static void main() {
        String q = "say \"hi\"";
        String b = "C:\\dir\\n";
        String mixed = "it's \"both\"";
        String first = "\"x\" 'y'";
        String joined = q + " | " + b + " | " + mixed + " | " + first;
        Commands.run("tellraw @a {\"text\":\"\",\"extra\":[{\"storage\":\"strescape:runtime\",\"nbt\":\"frames.d0.main.joined\"}]}");
        String twice = joined + joined;
        int n = twice.length();
        Commands.run("say lengths $(b.length()) $(joined.length()) $(n)");
        String swapped = Strings.replace(mixed, "\"", "'");
        Commands.run("say swapped $(swapped.length()) $(swapped == \"it's 'both'\")");
        Commands.run("say empty $((\"\" + \"\").length()) $(b == \"C:\" + \"\\\\dir\\\\n\")");
    }
}
