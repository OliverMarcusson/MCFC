import std.str.replace;

void main() {
    String q = "say \"hi\"";
    String b = "C:\\dir\\n";
    String mixed = "it's \"both\"";
    String first = "\"x\" 'y'";
    String joined = q + " | " + b + " | " + mixed + " | " + first;
    mcf("tellraw @a {\"text\":\"\",\"extra\":[{\"storage\":\"strescape:runtime\",\"nbt\":\"frames.d0.main.joined\"}]}");
    String twice = joined + joined;
    int n = twice.length();
    mcf("say lengths $(b.length()) $(joined.length()) $(n)");
    String swapped = replace(mixed, "\"", "'");
    mcf("say swapped $(swapped.length()) $(swapped == \"it's 'both'\")");
    mcf("say empty $((\"\" + \"\").length()) $(b == \"C:\" + \"\\\\dir\\\\n\")");
}
