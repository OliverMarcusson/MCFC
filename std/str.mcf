// String search helpers. Each comparison slices the string, so these cost a
// few commands per character; fine for names, ids, and short messages.

public boolean startsWith(String s, String prefix) {
    if (prefix.length() > s.length()) {
        return false;
    }
    return s.substring(0, prefix.length()) == prefix;
}

public boolean endsWith(String s, String suffix) {
    if (suffix.length() > s.length()) {
        return false;
    }
    return s.substring(s.length() - suffix.length()) == suffix;
}

// Index of the first `needle` in `s`, or -1.
public int find(String s, String needle) {
    var width = needle.length();
    var last = s.length() - width;
    var i = 0;
    while (i <= last) {
        if (s.substring(i, i + width) == needle) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

public boolean contains(String s, String needle) {
    return find(s, needle) != -1;
}
