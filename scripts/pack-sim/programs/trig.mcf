// std.math trig: rerouted sin/cos/tan and the MCFC arc functions.

class Main {
    static boolean near(float got, float want) {
        return Math.abs(got - want) < 0.00001;
    }

    @Test
    static void forwardTrig() {
        assert near(Math.sin(1.5707963), 1.0);
        assert near(Math.cos(3.14159265), -1.0);
        assert near(Math.tan(0.78539816), 1.0);
        assert near(Math.sin(0.5), Math.sin(0.5));
    }

    @Test
    static void atanValues() {
        assert near(Math.atan(0.0), 0.0);
        assert near(Math.atan(1.0), 0.78539816);
        assert near(Math.atan(-1.0), -0.78539816);
        assert near(Math.atan(0.3), 0.29145679);
        assert near(Math.atan(0.6), 0.5404195);
        assert near(Math.atan(2.5), 1.19028995);
        assert near(Math.atan(-40.0), -1.54580153);
        assert near(Math.atan(1000000.0), 1.5707953);
    }

    @Test
    static void atan2Quadrants() {
        assert near(Math.atan2(1.0, 1.0), 0.78539816);
        assert near(Math.atan2(1.0, -1.0), 2.35619449);
        assert near(Math.atan2(-1.0, -1.0), -2.35619449);
        assert near(Math.atan2(-1.0, 1.0), -0.78539816);
        assert near(Math.atan2(0.0, -2.0), 3.14159265);
        assert near(Math.atan2(3.0, 0.0), 1.5707963);
        assert near(Math.atan2(-3.0, 0.0), -1.5707963);
        assert near(Math.atan2(0.0, 0.0), 0.0);
    }

    @Test
    static void asinAcos() {
        assert near(Math.asin(0.5), 0.52359878);
        assert near(Math.asin(-1.0), -1.5707963);
        assert near(Math.asin(2.0), 1.5707963);
        assert near(Math.acos(0.5), 1.04719755);
        assert near(Math.acos(-1.0), 3.14159265);
        assert near(Math.acos(1.0), 0.0);
        assert near(Math.asin(0.0), 0.0);
    }

    public static void main() {
        Commands.run("function trig:test");
    }
}
