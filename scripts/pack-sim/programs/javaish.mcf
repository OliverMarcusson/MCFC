// Java expression forms: ?:, switch expressions, do-while, String +, number literals.
enum Stage { NEW, MID, DONE }

class Main {
    static int pick(boolean flag) {
        return flag ? 10 : 20;
    }

    static String label(Stage stage) {
        return switch (stage) {
            case NEW -> "fresh";
            case MID, DONE -> "old";
        };
    }

    static int code(String name) {
        return switch (name) {
            case "a" -> 1;
            case "b" -> { yield 2; }
            default -> 0;
        };
    }

    public static void main() {
        var a = pick(true) + pick(false);
        Commands.run("say ternary $(a)");
        var n = 7;
        var nested = n > 5 ? n > 6 ? "big" : "mid" : "small";
        Commands.run("say nested $(nested)");
        Commands.run("say switch $(label(Stage.NEW)) $(label(Stage.DONE))");
        var codes = code("a") * 100 + code("b") * 10 + code("zzz");
        Commands.run("say codes $(codes)");
        var i = 0;
        var steps = 0;
        do {
            i++;
            if (i == 2) {
                continue;
            }
            steps += 10;
        } while (i < 4);
        Commands.run("say dowhile $(i) $(steps)");
        var once = 0;
        do {
            once++;
        } while (false);
        Commands.run("say once $(once)");
        var text = "n=" + n + ", ok=" + (n > 3) + ", stage=" + Stage.MID;
        Commands.run("say $(text)");
        var hex = 0xFF + 1_000;
        Commands.run("say hex $(hex)");
        final int fixed = 4;
        Commands.run("say fixed $(fixed)");
    }
}
