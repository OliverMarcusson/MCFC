// Java library names: String, Integer, Math, List, Map, Optional, enum and record methods.
import std.math;

enum Stage { NEW, MID, DONE }

record Quest(String name, int reward) {}

// Compiled as part of the simulator pack; world commands need a game to execute.
void minecraftApi() {
    var selector = Selector.of("@e[type=minecraft:pig]");
    var pig = selector.getFirst();
    var maybePig = Selector.of("@e[type=minecraft:pig]").findFirst();
    if (pig.isValid() && maybePig.isPresent()) {
        pig.sendMessage("x=$(pig.getX())");
    }
    var bar = new BossBar("mcfc:javaapi", "API");
    bar.setMax(10);
    var sword = new ItemStack("minecraft:diamond_sword");
    sword.setName("Probe");
    debug((String) sword.getName());
}

void main() {
    var s = "hello world";
    var checks = (s.contains("lo w") ? 1000 : 0) + (s.startsWith("he") ? 100 : 0)
        + (s.endsWith("ld") ? 10 : 0) + (s.equals("hello world") ? 1 : 0);
    mcf("say string $(checks) $(s.indexOf(\"o\")) $(s.charAt(4)) $(s.isEmpty())");
    var parsed = Integer.parseInt("42") + 1;
    var text = String.valueOf(parsed) + Integer.toString(7);
    mcf("say parse $(text)");
    var m = math.max(3, 9) * 100 + math.min(3, 9) * 10 + math.abs(-2);
    mcf("say math $(m) $(math.clamp(15, 0, 10))");
    List<Integer> xs = List.of(4, 5, 6);
    xs.set(1, 50);
    var empty = xs.isEmpty();
    mcf("say list $(xs[1]) $(empty) $(xs.get(0).get()) $(xs.get(9).isEmpty())");
    Map<String, Integer> counts = Map.of("a", 1);
    counts.put("b", 2);
    mcf("say map $(counts[\"b\"]) $(counts.getOrDefault(\"zz\", 7)) $(counts.getOrDefault(\"a\", 7))");
    var total = 0;
    for (var stage : Stage.values()) {
        total += stage.ordinal();
    }
    mcf("say enum $(total) $(Stage.DONE.name()) $(Stage.values().size())");
    var quest = new Quest("Mine", 5);
    var better = new Quest(quest.name() + "!", quest.reward() * 2);
    mcf("say record $(better.name()) $(better.reward())");
}
