// Perlin noise. Smooth random values for terrain, particles and motion.

public final class Noise {
    // 2D Perlin noise, roughly -1..1 and 0 at whole-number points. Scale the
    // inputs to change the feature size, and offset them to get another pattern.
    public static float perlin(float x, float y) {
        var p = permutation();
        var xi = (int) x;
        var yi = (int) y;
        var xf = x - xi;
        var yf = y - yi;
        var u = fade(xf);
        var v = fade(yf);
        var a = p.get(xi % 256).orElse(0);
        var b = p.get((xi + 1) % 256).orElse(0);
        var aa = p.get((a + yi) % 256).orElse(0);
        var ab = p.get((a + yi + 1) % 256).orElse(0);
        var ba = p.get((b + yi) % 256).orElse(0);
        var bb = p.get((b + yi + 1) % 256).orElse(0);
        var bottom = lerp(grad(aa, xf, yf), grad(ba, xf - 1.0, yf), u);
        var top = lerp(grad(ab, xf, yf - 1.0), grad(bb, xf - 1.0, yf - 1.0), u);
        return lerp(bottom, top, v);
    }

    // Several octaves of perlin added up, each twice as detailed and half as strong.
    public static float fractal(float x, float y, int octaves) {
        var total = 0.0;
        var frequency = 1.0;
        var amplitude = 1.0;
        var range = 0.0;
        var i = 0;
        while (i < octaves) {
            total = total + perlin(x * frequency, y * frequency) * amplitude;
            range = range + amplitude;
            frequency = frequency * 2.0;
            amplitude = amplitude * 0.5;
            i = i + 1;
        }
        if (range == 0.0) {
            return 0.0;
        }
        return total / range;
    }

    static float fade(float t) {
        return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
    }

    static float lerp(float a, float b, float t) {
        return a + t * (b - a);
    }

    // One of eight gradient directions, picked by the hash.
    static float grad(int hash, float x, float y) {
        var h = hash % 8;
        if (h == 0) { return x + y; }
        if (h == 1) { return x - y; }
        if (h == 2) { return y - x; }
        if (h == 3) { return 0.0 - x - y; }
        if (h == 4) { return x; }
        if (h == 5) { return 0.0 - x; }
        if (h == 6) { return y; }
        return 0.0 - y;
    }

    // Ken Perlin's reference permutation.
    static List<Integer> permutation() {
        return List.of(
            151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225,
            140, 36, 103, 30, 69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148,
            247, 120, 234, 75, 0, 26, 197, 62, 94, 252, 219, 203, 117, 35, 11, 32,
            57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171, 168, 68, 175,
            74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122,
            60, 211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54,
            65, 25, 63, 161, 1, 216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169,
            200, 196, 135, 130, 116, 188, 159, 86, 164, 100, 109, 198, 173, 186, 3, 64,
            52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118, 126, 255, 82, 85, 212,
            207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170, 213,
            119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9,
            129, 22, 39, 253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104,
            218, 246, 97, 228, 251, 34, 242, 193, 238, 210, 144, 12, 191, 179, 162, 241,
            81, 51, 145, 235, 249, 14, 239, 107, 49, 192, 214, 31, 181, 199, 106, 157,
            184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254, 138, 236, 205, 93,
            222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180
        );
    }
}
