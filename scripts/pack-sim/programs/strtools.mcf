class Main {
    public static void main() {
        var s = "a,b,,c,,";
        var parts = s.split(",");
        Commands.run("say n $(parts.size())");
        for (var p : parts) { Commands.run("say part [$(p)]"); }
        var sep = ",,";
        var r = s.replace(sep, ";");
        Commands.run("say r $(r)");
        var ab = "ab";
        var e = ab.replace("", "-");
        Commands.run("say e $(e)");
        var hw = "Hello World";
        var u = hw.toUpperCase();
        var l = hw.toLowerCase();
        Commands.run("say u $(u) l $(l)");
        var xyz = "xyz";
        var chars = xyz.split("");
        Commands.run("say c $(chars.size())");
    }
}
