// A call whose argument calls the same function: `f(x, f(y))`.
class Main {
    static float wrap(float degrees) {
        var d = degrees;
        while (d > 180.0) {
            d = d - 360.0;
        }
        return d;
    }

    static int pick(int a, int b) {
        if (a > b) {
            return a;
        }
        return b;
    }

    static String join(String a, String b) {
        return a + "-" + b;
    }

    public static void main() {
        var camYaw = 180.0;
        // The inner call's early return used to make the outer call return at once.
        var w = wrap(camYaw + wrap(0.0) * 0.5);
        Commands.run("say wrap $(w)");
        // The inner call used to overwrite the outer call's first argument.
        var p = pick(1, pick(3, 2));
        Commands.run("say pick $(p)");
        var j = join("a", join("b", "c"));
        Commands.run("say join $(j)");
    }
}
