// Calls inside $(...) use this file's imports, like calls outside them.


import std.str.Strings;

class Main {
    static int twice(int x) {
        return x * 2;
    }

    public static void main() {
        var x = 7;
        var name = "steve";
        mcf("say $(twice(x)) $(Math.max(x, 9)) $(Math.clamp(x, 0, 5)) $(name.length()) $(Strings.startsWith(name, \"st\"))");
    }
}
