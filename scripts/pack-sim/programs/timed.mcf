class Main {
    @Tick
    static void tick() {
        var t = 1;
    }

    static int slowSum(int n) {
        var acc = 0;
        for (int i = 0; i < n; i++) {
            acc = acc + i;
            if (i % 2 == 0) {
                Thread.sleepTicks(1);
            }
        }
        return acc;
    }

    public static void main() {
        Thread.start(() -> {
            Thread.sleepTicks(3);
            Commands.run("say async done");
        });
        Commands.run("say before");
        var r = slowSum(5);
        Commands.run("say slow $(r)");
        var xs = List.of(5, 3, 9, 1, 7, 2);
        xs.sort();
        Commands.run("say sorted $(xs[0]) $(xs[1]) $(xs[5])");
        var flag = false;
        var n = 0;
        while (!flag) {
            n = n + 1;
            if (n >= 4 && n % 2 == 0) {
                flag = true;
            }
        }
        Commands.run("say flag $(n)");
    }
}
