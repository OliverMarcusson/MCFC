class Main {
    static int waitAndAdd(int a) {
        sleepTicks(2);
        return a + 1;
    }

    public static void main() {
        var i = 0;
        var acc = 0;
        while (i < 4) {
            i = i + 1;
            if (i == 2) {
                continue;
            }
            sleepTicks(1);
            acc = acc + i;
            if (acc > 6) {
                break;
            }
        }
        mcf("say loop $(i) $(acc)");
        var r = waitAndAdd(10);
        mcf("say waited $(r)");
        for (int k = 0; k < 3; k++) {
            if (k == 1) {
                sleepTicks(1);
                mcf("say resumed $(k)");
            }
        }
        mcf("say done");
    }
}
