void main() {
    var player = single(Selector.of("@a"));

    var npc_path = new EntityData("minecraft:wandering_trader");
    npc_path.nameVisible = false;
    npc_path.silent = true;
    npc_path.tags = List.of("trader");

    var npc = new EntityData("minecraft:mannequin");
    npc.nameVisible = false;
    npc.tags = List.of("npc");
    npc.nbt.profile.name = "7ks";

    var npc_name = new Component("Faithless");
    npc_name.color = "purple";

    var stick = new ItemStack("minecraft:stick");
    stick.nbt.Enchantments = "{\"minecraft:sharpness\": 10}";

    // player.give(stick)

    at (player) {
        var trader_ref = summon(npc_path);

        trader_ref.effect("minecraft:invisibility", 3600, 0);
        summon(npc);
    }
    return;
}

void tick() {
    var player = (Player) single(Selector.of("@a"));
    player.tellraw((String) player.nbt.SelectedItem.id);
    if ((String) player.nbt.SelectedItem.id == "minecraft:writable_book") {
        var book_content = (String) player.nbt.SelectedItem.components["minecraft:writable_book_content"].pages[0].raw;
        if (book_content[-1] == "@") {
            var yes_text = new Component("$(book_content) $(random(100))");
            yes_text.color = "gold";
            yes_text.bold = true;
            player.tellraw(yes_text);
        } else {
            player.tellraw("no");
        }
    } else {
        player.tellraw("no");
    }

    var traders = Selector.of("@e[tag=trader]");
    for (var trader : traders) {
        trader.mainhand.item = "minecraft:air";
        at (trader) {
            var npc = single(Selector.of("@e[type=minecraft:mannequin]"));
            npc.teleport(Block.of("~ ~ ~"));
            npc.nbt.Rotation = trader.nbt.Rotation;
        }
    }
    return;
}