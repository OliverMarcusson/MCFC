// Number helpers. Integer math is 32-bit and `/` rounds toward negative infinity.

// `min`, `max`, `abs`, `sign` and `clamp` are generic: they work on `int` and
// `float`, and mixing the two gives `float`, like Java.

public <T> T min(T a, T b) {
    if (a < b) {
        return a;
    }
    return b;
}

public <T> T max(T a, T b) {
    if (a > b) {
        return a;
    }
    return b;
}

public <T> T abs(T x) {
    if (x < 0) {
        return -x;
    }
    return x;
}

public <T> T sign(T x) {
    if (x > 0) {
        return 1;
    }
    if (x < 0) {
        return -1;
    }
    return 0;
}

public <T> T clamp(T x, T low, T high) {
    if (x < low) {
        return low;
    }
    if (x > high) {
        return high;
    }
    return x;
}

// Remainder with the sign of `b`, matching Minecraft's `%=` operation.
public int rem(int a, int b) {
    return a % b;
}

// `base` raised to `exponent`; exponents below zero return 0.
public int pow(int base, int exponent) {
    if (exponent < 0) {
        return 0;
    }
    var result = 1;
    var i = 0;
    while (i < exponent) {
        result = result * base;
        i = i + 1;
    }
    return result;
}

// Greatest common divisor of `a` and `b`, always zero or positive.
public int gcd(int a, int b) {
    var x = abs(a);
    var y = abs(b);
    while (y != 0) {
        var r = x % y;
        x = y;
        y = r;
    }
    return x;
}

// Point `t` of the way from `a` to `b`: 0.0 gives `a`, 1.0 gives `b`.
public float lerp(float a, float b, float t) {
    return a + (b - a) * t;
}

// Whole-number square root, rounded down. Negative `n` gives 0.
public int isqrt(int n) {
    if (n <= 0) {
        return 0;
    }
    var root = (int) Math.sqrt(n);
    while (root * root > n) {
        root = root - 1;
    }
    while ((root + 1) * (root + 1) <= n) {
        root = root + 1;
    }
    return root;
}
