import std.noise;

void show(float x, float y) {
    var n = noise.perlin(x, y);
    var milli = (int) (n * 1000.0);
    mcf("say perlin $(milli)");
}

void main() {
    show(0.5, 0.5);
    show(3.7, -2.2);
    show(10.25, 4.75);
    show(-0.3, 0.9);
    show(2.0, 5.0);
    var f = noise.fractal(1.3, 2.6, 3);
    var fm = (int) (f * 1000.0);
    mcf("say fractal $(fm)");
}
